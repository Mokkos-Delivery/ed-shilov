{
  "name": "eduard-shilov-firebase-drive",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node tools/build.mjs",
    "prepare": "node tools/build.mjs --draft",
    "test": "node --test tests/*.test.mjs",
    "check": "node tools/check.mjs",
    "test:rules": "firebase emulators:exec --only firestore --project demo-eduard-shilov --config firebase.emulators.json \"node --test tests/firestore.rules-test.mjs\"",
    "test:hosting": "node tools/hosting-emulator.cjs emulators:exec --only hosting --project demo-eduard-shilov --config firebase.hosting-test.json \"node --test tests/hosting.rules-test.mjs\"",
    "configure": "node tools/rollout.mjs configure",
    "doctor": "node tools/rollout.mjs doctor",
    "bundle:worker": "node tools/rollout.mjs bundle",
    "deploy:worker": "node tools/rollout.mjs worker",
    "secrets:worker": "node tools/rollout.mjs secrets",
    "deploy:hosting": "node tools/rollout.mjs hosting",
    "smoke": "node tools/rollout.mjs smoke",
    "test:runtime": "node --test tests/worker.runtime-test.mjs",
    "preinstall": "node tools/check-node.cjs",
    "verify:live": "node tools/verify-live.mjs"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "firebase": "13.0.0",
    "firebase-tools": "15.33.0",
    "google-auth-library": "9.15.1",
    "https-proxy-agent": "7.0.6",
    "wrangler": "4.154.0"
  },
  "engines": {
    "node": ">=24.12.0"
  },
  "overrides": {
    "@grpc/grpc-js@<1.13.6": "1.14.6",
    "basic-ftp@<6.2.1": "6.2.3",
    "@opentelemetry/core@<2.8.0": "2.8.0",
    "uuid@<11.1.1": "11.1.1"
  }
}
